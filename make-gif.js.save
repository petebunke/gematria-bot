const { chromium } = require("playwright");
const { execSync } = require("child_process");
const fs = require("fs");

const DISCORD_WEBHOOK = "https://discord.com/api/webhooks/1463784586575347769/vu_n8qaeZvARa5Mv60W6E5GeLTlKm208pPnMw5fg_WTkU0iHDd4jyz-_lqEz1Q89awEn";

async function postToDiscord(phrase, values, gifPath) {
    const message = `${phrase} (${values})`;
    
    const formData = new FormData();
    formData.append("content", message);
    formData.append("file", new Blob([fs.readFileSync(gifPath)]), "gematria.gif");
    
    const res = await fetch(DISCORD_WEBHOOK, {
        method: "POST",
        body: formData
    });
    
    if (res.ok) {
        console.log("Posted to Discord!");
    } else {
        console.log("Discord error:", await res.text());
    }
}

(async () => {
    const browser = await chromium.launch({ headless: false });
    const page = await browser.newPage();
    
    await page.goto("https://gematriagenerator.app");
    await page.waitForSelector("button:has-text(\"Loading\")", { state: "hidden", timeout: 60000 });
    console.log("Page loaded");
    
